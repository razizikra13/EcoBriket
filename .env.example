# Salin file ini menjadi .env lalu isi sesuai kebutuhan. JANGAN commit file .env.
PORT=3000
# Alamat yang dibuka di browser. Harus sama persis dengan yang didaftarkan di Google/GitHub.
BASE_URL=http://localhost:3000

# --- Masuk dengan Google (opsional) ---
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application
# Authorized JavaScript origins: http://localhost:3000
GOOGLE_CLIENT_ID=

# --- Masuk dengan GitHub (opsional) ---
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Lama sesi login (hari)
SESSION_DAYS=30
# Lokasi database JSON (relatif terhadap folder proyek)
DB_FILE=data/db.json
# Isi 1 jika berjalan di belakang reverse proxy (Nginx, Render, Railway)
TRUST_PROXY=0
